# Server Configuration
PORT=3000
NODE_ENV=development

# GitHub REST API (Optional in dev, increases rate limit from 60 to 5,000 req/hr)
# Never expose this to client-side code!
GITHUB_TOKEN=""

# Google Gemini API Key (Required in Phase 4 for AI interpretation layer)
# AI Studio automatically injects this at runtime from user secrets.
# Never expose this to client-side code!
GEMINI_API_KEY=""

# Public Application URL
APP_URL=""
